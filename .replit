run = "streamlit run app.py --server.port=5000 --server.address=0.0.0.0 --server.headless=true"
entrypoint = "app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"

[deployment]
run = ["sh", "-c", "python main.py"]

[env]
PYTHONPATH = "${PYTHONPATH}:${HOME}/${REPL_SLUG}"

[[ports]]
localPort = 8501
externalPort = 80

