# Replit Configuration for FinRobot
# AI-Powered Financial Analysis Platform with Multi-Agent System

# Main run command - starts Streamlit web interface
run = "streamlit run app.py --server.port=5000 --server.address=0.0.0.0 --server.headless=true"

# Entry point for the application
entrypoint = "app.py"

# Python version
modules = ["python-3.11"]

# Nix channel
[nix]
channel = "stable-23_11"

# Deployment configuration
[deployment]
run = ["sh", "-c", "streamlit run app.py --server.port=5000 --server.address=0.0.0.0 --server.headless=true"]

# Environment variables
[env]
PYTHONPATH = "${PYTHONPATH}:${HOME}/${REPL_SLUG}"
# Add your API keys here or use Replit Secrets:
# OPENAI_API_KEY = "your-key-here"
# FINNHUB_API_KEY = "your-key-here"
# FMP_API_KEY = "your-key-here"
# SEC_API_KEY = "your-key-here"

# Port configuration
[[ports]]
localPort = 5000
externalPort = 80
protocol = "http"

# Language configuration
[interpreter]
command = ["python3", "-u"]

# LSP configuration for better code completion
[languages.python3]
pattern = "**/*.py"

[languages.python3.languageServer]
start = "pylsp"
